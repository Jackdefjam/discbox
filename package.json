{
  "name": "discbox",
  "version": "1.0.0",
  "description": "Deine CD-Sammlung in 3D: Musik vom NAS durchblättern, Hüllen drehen und öffnen, Cover und Backcover scrapen, direkt im Browser abspielen.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch-path=server server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "testlib": "bash scripts/make-test-library.sh"
  },
  "dependencies": {
    "express": "^5.3.0",
    "music-metadata": "^12.7.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "concurrently": "^10.0.7",
    "three": "^0.187.0",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jackdefjam/discbox.git"
  },
  "keywords": [
    "cd",
    "music",
    "3d",
    "coverflow",
    "nas",
    "jukebox",
    "three.js",
    "musicbrainz"
  ]
}
